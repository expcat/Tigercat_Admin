{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=tigercat_admin.db",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AuthRateLimit": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "ImportJobs": {
    "ProgressIntervalMilliseconds": 250
  },
  "Media": {
    "Provider": "Local",
    "MaxBytes": 10485760,
    "PublicCacheSeconds": 3600
  },
  "AllowedHosts": "*"
}
